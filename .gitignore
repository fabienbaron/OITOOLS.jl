# Files generated by invoking Julia with --code-coverage
*.jl.cov
*.jl.*.cov

# Files generated by invoking Julia with --track-allocation
*.jl.mem

Manifest.toml

# The GUI sysimage built by bin/compile.jl. Roughly a gigabyte, and tied to one machine's
# Julia version and this project's Manifest, so it is built rather than committed.
bin/*.so
bin/*.dylib
bin/*.dll

# Machine-local Preferences. The one you are most likely to want here is PrecompileTools':
#
#     [PrecompileTools]
#     precompile_workloads = false
#
# which skips src/precompile.jl and takes a cold precompile of OITOOLS from ~25 s to ~4.5 s
# — worth it while iterating on src/, at the cost of a ~30 s first call to the image
# reconstruction path in every new session. Turn it back on before benchmarking or releasing.
LocalPreferences.toml

# Build artifacts for creating documentation generated by the Documenter package
docs/build/
docs/site/

# Python bytecode (demos/bootstrap_validation/stubs)
__pycache__/
*.pyc

# CondaPkg's resolved Python environment (like Manifest.toml, it is machine-specific and
# regenerated from CondaPkg.toml). CondaPkg.toml itself IS committed.
.CondaPkg/

# Figures generated by the test suite (test/test_plotting.jl writes test/figures/plotting
# on every run). Regenerated artifacts, not reference images — the plotting assertions
# compare artist data, not pixels.
test/figures/

# Working notes kept alongside the code: memory/ is the assistant's cross-session notes and
# plans/ holds design documents still being drafted. Neither is part of the package, and both
# are personal to whoever is working in this clone.
memory/
plans/
